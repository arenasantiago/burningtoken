# Truth Tribunal - Environment Variables Example
# Reto Convex:
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Reto Linkup (Deep Research):
LINKUP_API_KEY=your_linkup_api_key_here

# Reto Nebius (Token Factory - Applied AI):
NEBIUS_API_KEY=your_nebius_api_key_here
# Modelo disponible comprobado con /v1/models el 2026-09-08. Configurar también en Convex para sobrescribirlo.
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Reto RevenueCat (Subscriptions / Test Store):
VITE_REVENUECAT_PUBLIC_KEY=your_revenuecat_public_web_key_here
